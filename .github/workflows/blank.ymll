name: pc virtual online

on:
  workflow_dispatch:

jobs:
  tailscale:
    runs-on: windows-latest

    steps:
      - name: Instalar Tailscale
        shell: powershell
        run: |
          $url = "https://pkgs.tailscale.com/stable/tailscale-setup-latest.exe"
          Invoke-WebRequest -Uri $url -OutFile "$env:TEMP\tailscale.exe"
          Start-Process "$env:TEMP\tailscale.exe" -ArgumentList "/S" -Wait

      - name: Conectar ao Tailscale
        shell: powershell
        env:
          TAILSCALE_AUTH_KEY: ${{ secrets.TAILSCALE_AUTH_KEY }}
        run: |
          & "C:\Program Files\Tailscale\tailscale.exe" up --authkey="$env:TAILSCALE_AUTH_KEY"

      - name: Verificar conexão
        shell: powershell
        run: |
          & "C:\Program Files\Tailscale\tailscale.exe" status
          & "C:\Program Files\Tailscale\tailscale.exe" ip -4
